<!doctype html>
<html lang="fo">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width,initial-scale=1" />
	<title>Djóralæknatænastan — Kelidýr við tryggari hond</title>
	<meta name="description" content="Djóralæknatænastan — umsorgan, serkunnleiki og yvir 20 ár av royndum" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
	<style>
		:root{
			--bg:#0f1724; --card:#ffffff; --muted:#94a3b8; --accent-1:#ff7aa2; --accent-2:#7c5cff;
			--radius:16px; --container:1200px; --glass: rgba(255,255,255,0.06);
		}
		*{box-sizing:border-box}
		html,body{height:100%}
		body{font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif; margin:0; background:linear-gradient(180deg,#071029 0%, #071b2f 100%); color:#e6eef8; -webkit-font-smoothing:antialiased}
		.site{max-width:var(--container); margin:0 auto; padding:0 20px}

		/* Header */
		header.topbar{position:sticky; top:0; z-index:60; backdrop-filter: blur(6px); background:linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.02)); border-bottom:1px solid rgba(255,255,255,0.03)}
		.topbar .bar{display:flex; align-items:center; justify-content:space-between; gap:20px; padding:14px 0}
		.logo{display:flex; align-items:center; gap:12px; font-weight:700; color:#fff}
		.logo .mark{width:44px; height:44px; display:inline-grid; place-items:center; border-radius:10px; background:linear-gradient(135deg,var(--accent-1),var(--accent-2)); box-shadow:0 6px 18px rgba(124,92,255,0.15)}
		nav.primary{display:flex; gap:18px; align-items:center}
		nav.primary a{color:var(--muted); text-decoration:none; font-weight:600}
		.cta{background:linear-gradient(90deg,var(--accent-1),var(--accent-2)); padding:10px 14px; border-radius:10px; color:white; font-weight:700; text-decoration:none}
		.mobile-toggle{display:none; background:transparent; border:0; color:var(--muted)}

		/* Hero */
		.hero{display:grid; grid-template-columns: 1fr 420px; gap:28px; align-items:center; padding:56px 0}
		.hero-card{background:linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.02)); padding:28px; border-radius:20px; box-shadow:0 10px 30px rgba(2,6,23,0.6)}
		h1{font-size:clamp(28px,4.2vw,44px); margin:0 0 12px; color:#fff}
		.lead{color:var(--muted); margin:0 0 18px}
		.hero-actions{display:flex; gap:12px; margin-top:18px}

		/* Cards grid */
		.grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:18px}
		.service{background:var(--card); color:#0b1220; padding:18px; border-radius:14px; box-shadow:0 6px 18px rgba(2,6,23,0.25)}
		.service h3{margin:0 0 6px}
		.service p{margin:0; color:#42506b; font-size:14px}

		/* Highlight */
		.highlight{display:flex; gap:18px; align-items:center; padding:20px; border-radius:14px; background:linear-gradient(90deg, rgba(255,122,162,0.08), rgba(124,92,255,0.06)); border:1px solid rgba(255,255,255,0.03)}

		/* Why choose */
		.three-up{display:grid; grid-template-columns:repeat(3,1fr); gap:18px}

		/* Team */
		.team{display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:18px}

		/* CTA */
		.cta-panel{background:var(--card); color:#071032; padding:28px; border-radius:14px; text-align:center}

		footer{padding:28px 0; color:var(--muted); display:flex; justify-content:space-between; align-items:center; gap:12px}

		/* Responsive */
		@media (max-width:980px){
			.hero{grid-template-columns:1fr}
			.topbar nav.primary{display:none}
			.mobile-toggle{display:block}
		}

		@media (prefers-reduced-motion:reduce){
			*{transition:none!important}
		}
	</style>
</head>
<body>
	<header class="topbar">
		<div class="site bar">
			<div class="logo"><div class="mark">🐶</div><div><div style="font-size:14px;opacity:.95">Djóralæknatænastan</div><div style="font-size:12px;color:var(--muted)">Kelidýr við tryggari hond</div></div></div>
			<nav class="primary" aria-label="Primary">
				<a href="#home">Heim</a>
				<a href="#services">Tænastur</a>
				<a href="#about">Um okkum</a>
				<a href="#team">Toymið</a>
				<a class="cta" href="#book">Bóka tíð</a>
			</nav>
			<button class="mobile-toggle" aria-label="Open menu" id="navToggle">☰</button>
		</div>
	</header>

	<main class="site">
		<section class="hero">
			<div class="hero-card">
				<p style="color:var(--accent-2); font-weight:700; margin:0 0 8px; letter-spacing:.6px">Kelidýr við tryggari hond</p>
				<h1>Tá dýrið vísir ólukt — vit eru her at hjálpa</h1>
				<p class="lead">Umsorgan, serkunnleiki og yvir 20 ár av royndum. Heilsukanningar, skurðviðgerðir, tannrøkt, koppseting og bráðfeingishjálp.</p>
				<div class="hero-actions">
					<a class="cta" href="#book">Bóka tíð</a>
					<a href="#services" style="color:var(--muted); align-self:center; text-decoration:none; font-weight:600">Les um tænastur</a>
				</div>
				<div style="display:flex; gap:14px; margin-top:20px; color:var(--muted)">
					<div style="background:rgba(255,255,255,0.03); padding:10px 12px; border-radius:12px">🔒  Tryggið</div>
					<div style="background:rgba(255,255,255,0.03); padding:10px 12px; border-radius:12px">⭐  20+ ár</div>
				</div>
			</div>

			<aside class="hero-card" aria-hidden="true">
				<img src="https://via.placeholder.com/420x300?text=Veterinarian" alt="Veterinarian with puppies" style="width:100%; border-radius:12px; display:block; margin-bottom:12px">
				<p style="margin:0 0 8px; color:var(--muted)">Sérfrøðingar í smáum og stórum djórum</p>
				<div style="display:flex; gap:8px; color:var(--muted)">
					<div style="font-weight:700">Bílegg online</div>
				</div>
			</aside>
		</section>

		<section id="services" style="padding:28px 0">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px">
				<h2 style="margin:0">Tænastur</h2>
				<a href="#services" style="color:var(--muted); text-decoration:none">Sí allar</a>
			</div>
			<div class="grid">
				<article class="service">
					<h3>Heilsukanningar</h3>
					<p>Full umfangs kanning av tínum familjudýri — vit byrja við eini heilsukanning.</p>
				</article>
				<article class="service">
					<h3>Skurðviðgerðir</h3>
					<p>Moderna kirurgi og post-op umsorgan.</p>
				</article>
				<article class="service">
					<h3>Tannrøkt</h3>
					<p>Tannrøkt og munnheilsa fyri betri lívsgóðsku.</p>
				</article>
				<article class="service">
					<h3>Koppseting</h3>
					<p>Trygg og álitandi fyribyrging fyri smittusjúkur.</p>
				</article>
				<article class="service">
					<h3>Røntgen & Ultraljóð</h3>
					<p>On-site diagnostikk við skjótu úrslitum.</p>
				</article>
				<article class="service">
					<h3>Bráðfeingishjálp</h3>
					<p>Við skjóta svarførleika tá tað hasar.</p>
				</article>
			</div>
		</section>

		<section style="padding:18px 0">
			<div class="highlight">
				<div style="flex:1">
					<h3 style="margin:0 0 6px">Ivast tú? Byrja við eina heilsukanning</h3>
					<p style="margin:0; color:var(--muted)">Einkel prosess at fáa eina vitjan — vit tekna eitt persónligt eftirlit fyri títt dýr.</p>
					<div style="margin-top:12px; display:flex; gap:8px">
						<a class="cta" href="#book">Bóka nú</a>
						<a href="#" style="color:var(--muted); align-self:center; text-decoration:none">Fá meira</a>
					</div>
				</div>
				<div style="min-width:260px; background:var(--card); color:#071032; padding:14px; border-radius:12px">
					<strong>Heilsukanningin inniber:</strong>
					<ul style="margin:8px 0 0 18px; color:#234; padding:0">
						<li>Full kropsroynd</li>
						<li>Vaccination review</li>
						<li>Personal ráðgeving</li>
					</ul>
				</div>
			</div>
		</section>

		<section id="about" style="padding:18px 0">
			<h2>Hví velja okkum?</h2>
			<div class="three-up" style="margin-top:12px">
				<div class="service"><h3>Umsorgan & virðing</h3><p>Vit seta umsorgan og virðing fyrst fyri bæði dýr og eigara.</p></div>
				<div class="service"><h3>Serkunnleiki</h3><p>Sérfrøðingur í smáum og stórum djórum.</p></div>
				<div class="service"><h3>20+ ár</h3><p>Meira enn tjúgu ár av praktiskari roynd.</p></div>
			</div>
		</section>

		<section id="team" style="padding:18px 0">
			<h2>Toymið</h2>
			<div class="team" style="margin-top:12px">
				<div class="service"><img src="https://via.placeholder.com/400x220?text=Hanus" alt="Hanus" style="width:100%; border-radius:10px; margin-bottom:10px"><h3>Hanus</h3><p>Kelidýr og familjudýr</p></div>
				<div class="service"><img src="https://via.placeholder.com/400x220?text=Vet+outside" alt="Vet outside" style="width:100%; border-radius:10px; margin-bottom:10px"><h3>Anna</h3><p>Samband millum dýr og eigara</p></div>
				<div class="service"><img src="https://via.placeholder.com/400x220?text=Kristina" alt="Kristina" style="width:100%; border-radius:10px; margin-bottom:10px"><h3>Kristina</h3><p>Skurðviðgerðir og starvsstova</p></div>
			</div>
		</section>

		<section style="padding:28px 0">
			<div class="cta-panel">
				<h3 style="margin:0 0 8px">Hava tit tørv á fakligari meting?</h3>
				<p style="margin:0 0 14px; color:var(--muted)">Ring okkum ella send boð — vit svara skjótan.</p>
				<div style="display:flex; gap:10px; justify-content:center; margin-top:12px">
					<a class="cta" href="tel:+298000000">Ring djóralækna</a>
					<a href="#" style="background:transparent; padding:10px 12px; border-radius:10px; border:1px solid rgba(255,255,255,0.06); color:var(--muted); text-decoration:none">Send boð á Messenger</a>
				</div>
			</div>
		</section>
	</main>

	<footer class="site">
		<div style="display:flex; gap:12px; align-items:center"><div class="mark" style="background:transparent">🐶</div><div>Djóralæknatænastan</div></div>
		<div>© <span id="year"></span></div>
		<div style="color:var(--muted)">Kelidýr trygg – eigari róligur</div>
	</footer>

	<script>
		// Small UI: mobile nav + year
		document.getElementById('year').textContent = new Date().getFullYear();
		const navToggle = document.getElementById('navToggle');
		navToggle && navToggle.addEventListener('click', ()=>{
			const nav = document.querySelector('nav.primary');
			if(!nav) return;
			if(getComputedStyle(nav).display === 'none'){
				nav.style.display = 'flex';
				nav.style.flexDirection = 'column';
				nav.style.position = 'absolute';
				nav.style.right = '20px';
				nav.style.top = '68px';
				nav.style.background = 'linear-gradient(180deg, rgba(2,6,23,0.9), rgba(2,6,23,0.85))';
				nav.style.padding = '12px';
				nav.style.borderRadius = '12px';
			} else {
				nav.style.display = 'none';
			}
		});
	</script>
</body>
</html>

